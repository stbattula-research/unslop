#!/usr/bin/env python3
"""audit — pre-launch website audit.

Scans a local static site directory or a deployed URL against a pre-launch
checklist: SEO/meta tags, social previews, favicon, robots/sitemap, links,
images, forms, custom 404, leaked secrets, security headers, and page weight.

Zero dependencies — stdlib only. Works offline for local directories.

Usage:
    audit <dir>                    audit a local static site directory
    audit <url>                    audit a deployed site (http:// or https://)

    audit <target> --format json   machine-readable output
    audit <target> --only seo,links
    audit <target> --skip perf
    audit <target> --check-external   also HEAD external links (slow)
    audit <target> --no-fail           always exit 0

Exit code: 1 if any check failed, 0 otherwise (unless --no-fail).
"""

import argparse
import html as htmlmod
import json
import os
import re
import sys
import urllib.parse
import urllib.request
from collections import Counter
from html.parser import HTMLParser
from pathlib import Path

